{
  "name": "langchainsystem",
  "version": "0.0.1",
  "description": "ioio.to",
  "license": "ISC",
  "author": "thoschulte@gmail.com",
  "type": "module",
  "scripts": {
    "i": "npm install --legacy-peer-deps",
    "frontend": "npm --prefix ./frontend run start",
    "build": "tsc",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "server": "node src/server.js",
    "start": "npm run build && npm run server",
    "react-agent-executor": "tsc && node dist/react-agent-executor.js",
    "core": "tsc && node -e \"import('./dist/core.js').then(m => m.runLlm('Was ist LangChain?')).then(res => console.dir(res, { depth: 2 }));\"",
    "index": "tsc && node dist/index.js",
    "ingestion": "tsc && node dist/ingestion.js",
    "langgraph-cli:dev": "npx @langchain/langgraph-cli dev",
    "nodemon": "npx concurrently -n tsc,nodemon -c blue,green \"tsc --watch\" \"nodemon dist/index.js\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "npx concurrently \"npx rimraf dist/\" \"npx rimraf node_modules\"",
    "docker:up": "npx concurrently \"npm run docker:extern:up\" \"npm run docker:intern:up\"",
    "docker:intern:up": "npx concurrently \"npm run docker:chroma && npm run docker:chroma-ui\" \"npm run docker:unstructured\"",
    "docker:extern:up": "npx concurrently \"npm run docker:firecrawl:up\" \"npm run docker:langfuse:up\"",
    "docker:chroma-ui": "docker run -p 8001:3001 -d --name chroma-ui fengzhichao/chromadb-admin",
    "docker:chroma": "docker run -d --name chroma -v ./chroma-data:/data -p 8000:8000 chromadb/chroma",
    "docker:unstructured": "docker run -d --name unstructured -p 8002:8000 downloads.unstructured.io/unstructured-io/unstructured-api:latest",
    "docker:firecrawl:up": "docker compose -f ../firecrawl/docker-compose.yaml up -d",
    "docker:firecrawl:down": "docker compose -f ../firecrawl/docker-compose.yaml down",
    "docker:langfuse:up": "docker compose -f ../langfuse/docker-compose.yml up -d",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "@langchain/anthropic": "^1.5.3",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.5",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/ollama": "^1.3.0",
    "@langchain/pinecone": "^1.0.3",
    "@langchain/tavily": "^1.2.0",
    "@pinecone-database/pinecone": "^5.1.2",
    "@tavily/core": "^0.7.7",
    "chromadb": "^3.5.0",
    "dotenv": "^16.6.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "firecrawl": "^4.35.0",
    "langchain": "^1.5.4",
    "langsmith": "^0.8.9",
    "ramda": "^0.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/ramda": "^0.32.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
